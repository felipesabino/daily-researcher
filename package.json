{
  "name": "daily-researcher",
  "version": "1.0.0",
  "description": "CLI tool that aggregates Google CSE news results, summarizes with OpenAI, and stores daily briefs as Markdown.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "daily-researcher": "./cli.js"
  },
  "scripts": {
    "start": "node cli.js --topics ./config/topics.json",
    "dry-run": "node cli.js --dry-run --topics ./config/topics.json",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "news",
    "cli",
    "openai",
    "google"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.8",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^17.2.3",
    "got": "^12.6.1",
    "marked": "^17.0.0",
    "openai": "^6.8.1",
    "p-limit": "^7.2.0",
    "yargs": "^17.7.2"
  }
}
