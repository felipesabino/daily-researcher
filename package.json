{
  "name": "daily-researcher",
  "version": "1.0.0",
  "description": "CLI tool that aggregates Perigon news results, summarizes with OpenAI, and emails daily briefs.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "daily-researcher": "./cli.js"
  },
  "scripts": {
    "start": "node cli.js --topics ./config/topics.json",
    "dry-run": "node cli.js --dry-run --topics ./config/topics.json",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "news",
    "cli",
    "openai",
    "perigon"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@goperigon/perigon-ts": "^2.2.0",
    "dotenv": "^17.2.3",
    "marked": "^17.0.0",
    "nodemailer": "^7.0.10",
    "openai": "^6.8.1",
    "p-limit": "^7.2.0",
    "yargs": "^17.7.2"
  }
}
